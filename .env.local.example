# Meta WhatsApp Cloud API
META_WHATSAPP_TOKEN=           # Permanent access token from Meta Developer Portal
META_PHONE_NUMBER_ID=          # Your WhatsApp phone number ID
META_WEBHOOK_VERIFY_TOKEN=     # Any string you choose (used to verify webhook)
META_APP_SECRET=               # App Secret from Meta App Dashboard (for signature verification)

# Google Gemini AI (free tier — 15 requests/min) — used by the embroidery bot
# Get your key: https://aistudio.google.com/apikey (sign in with Google, click "Create API Key")
GEMINI_API_KEY=

# Groq AI (free tier — ~14,400 requests/day, very fast) — Layer 3 fallback for the food bot
# Get your key: https://console.groq.com/keys (free signup, click "Create API Key")
# Optional: leave GROQ_API_KEY blank to disable the AI fallback (bot still works via flow + FAQ).
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant   # Optional override; defaults to llama-3.1-8b-instant

# Supabase
NEXT_PUBLIC_SUPABASE_URL=      # Supabase project URL (e.g. https://xxx.supabase.co)
SUPABASE_SERVICE_ROLE_KEY=     # Service role key (server-side only, never expose to client)

# Bot mode: which business this instance serves
BOT_MODE=                      # "food" or "embroidery" (default: embroidery)

# Kitchen management (food bot only)
KITCHEN_PIN=                   # 4-6 digit PIN for the /kitchen/menu page

# Seller config (hardcoded for MVP — one client)
SELLER_WHATSAPP_NUMBER=        # Friend's WhatsApp number WITH country code (e.g. 919876543210)
SELLER_BUSINESS_NAME=          # e.g. "Priya's Embroidery"
SELLER_BUSINESS_NAME_TAMIL=    # e.g. "பிரியாவின் எம்பிராய்டரி"
SELLER_LOCATION=               # e.g. "Anna Nagar, Chennai"
SELLER_WORKING_HOURS=          # e.g. "9 AM - 7 PM, Monday to Saturday"
